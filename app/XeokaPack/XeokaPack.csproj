<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>XEOKA-PACK</AssemblyName>
    <RootNamespace>XeokaPack</RootNamespace>
    <Version>3.14.2</Version>
    <AssemblyVersion>3.14.2.0</AssemblyVersion>
    <FileVersion>3.14.2.0</FileVersion>
    <Product>XEOKA PACK</Product>
    <Company>XEOKA</Company>
    <Copyright>t.me/CMEPT0HOCHbIU</Copyright>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8765;CS8767</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <EmbeddedResource Include="Assets\Sounds\*.wav" />
    <!-- Видео для экрана активации: не встраивается в exe (слишком большое для single-file), едет рядом отдельным файлом. -->
    <None Include="Assets\activation.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
