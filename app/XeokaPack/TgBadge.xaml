<UserControl x:Class="XeokaPack.TgBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="50" Height="50" SnapsToDevicePixels="False">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="Opacity" From="0.15" To="0.75" Duration="0:0:1.5">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="Opacity" From="0.05" To="0.45" Duration="0:0:1.5">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Ring2Sc" Storyboard.TargetProperty="ScaleX" From="0.97" To="1.05" Duration="0:0:1.5"/>
                    <DoubleAnimation Storyboard.TargetName="Ring2Sc" Storyboard.TargetProperty="ScaleY" From="0.97" To="1.05" Duration="0:0:1.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">
            <Ellipse x:Name="Ring2" Canvas.Left="2" Canvas.Top="2" Width="96" Height="96" StrokeThickness="2.2" Opacity="0.2" RenderTransformOrigin="0.5,0.5"
                     Stroke="{Binding RingBrush, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Ellipse.RenderTransform><ScaleTransform x:Name="Ring2Sc"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Ring1" Canvas.Left="9" Canvas.Top="9" Width="82" Height="82" StrokeThickness="2.2" Opacity="0.3"
                     Stroke="{Binding RingBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Ellipse Canvas.Left="12" Canvas.Top="12" Width="76" Height="76" Fill="{StaticResource TgGradient}"/>
            <Ellipse Canvas.Left="12" Canvas.Top="12" Width="76" Height="76" Stroke="#55FFFFFF" StrokeThickness="1.4"/>
            <Canvas>
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="-231" Y="-243"/>
                        <ScaleTransform ScaleX="0.0919" ScaleY="0.0919"/>
                        <TranslateTransform X="49" Y="50.5"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Path Data="M16,252 L432,70 L370,420 L265,342 L200,395 L207,290 L117,284 Z" Fill="White"/>
                <Path Data="M200,395 L207,290 L265,342 Z" Fill="#B8E3FA"/>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
