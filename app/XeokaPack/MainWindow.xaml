<Window x:Class="XeokaPack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:XeokaPack"
        Title="XEOKA OPTIMIZATION" Width="1240" Height="820" MinWidth="980" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" Background="#030208" Opacity="0"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged" Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="96" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Карточка твика -->
        <DataTemplate x:Key="TweakCard">
            <Border x:Name="Card" Width="{Binding Source={StaticResource Layout}, Path=CardWidth}" MinHeight="98" Margin="0,0,12,12"
                    CornerRadius="16" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.2"
                    Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="TweakCard_Click" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><TranslateTransform x:Name="CardT" Y="0"/></Border.RenderTransform>
                <Grid>
                    <Border x:Name="OnRing" CornerRadius="16" BorderThickness="1.2" BorderBrush="{DynamicResource AccentBrush}" Opacity="0"/>
                    <Border x:Name="Hover" CornerRadius="16" BorderThickness="1.2" BorderBrush="{DynamicResource Accent2Brush}" Background="#1E8B5CF6" Opacity="0"/>
                    <Border x:Name="Bar" Width="4" HorizontalAlignment="Left" Margin="0,24" CornerRadius="2" Background="{DynamicResource Accent2Brush}" Opacity="0"/>
                    <Grid Margin="22,14,18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Desc}" FontSize="12.5" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" Visibility="{Binding StateVis}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                            <DoubleAnimation Storyboard.TargetName="CardT" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/>
                            <DoubleAnimation Storyboard.TargetName="CardT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OnRing" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                        </Storyboard></BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OnRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                        </Storyboard></BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Карточка инструмента -->
        <DataTemplate x:Key="ToolCard">
            <Border x:Name="Card" Width="{Binding Source={StaticResource Layout}, Path=ToolWidth}" Height="84" Margin="0,0,12,12"
                    CornerRadius="16" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.2"
                    Cursor="Hand" Tag="{Binding}" Opacity="{Binding Opacity}" MouseLeftButtonUp="ToolCard_Click" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><TranslateTransform x:Name="CardT" Y="0"/></Border.RenderTransform>
                <Grid>
                    <Border x:Name="Hover" CornerRadius="16" BorderThickness="1.2" BorderBrush="{DynamicResource Accent2Brush}" Background="#1E8B5CF6" Opacity="0"/>
                    <Grid Margin="18,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="48" Height="48">
                            <Ellipse Fill="{Binding Badge}"/>
                            <TextBlock Text="{Binding Glyph}" FontSize="11.5" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Info}" FontSize="12.5" Foreground="{Binding InfoBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Path Grid.Column="2" Data="M0,0 L6,6 L0,12" Stroke="{DynamicResource Accent2Brush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Opacity="0.7"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                            <DoubleAnimation Storyboard.TargetName="CardT" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/>
                            <DoubleAnimation Storyboard.TargetName="CardT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Строка журнала -->
        <DataTemplate x:Key="LogLine">
            <TextBlock x:Name="T" Text="{Binding Text}" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource TextBrush}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter TargetName="T" Property="Foreground" Value="{DynamicResource OkBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter TargetName="T" Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Err"><Setter TargetName="T" Property="Foreground" Value="{DynamicResource ErrBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Dim"><Setter TargetName="T" Property="Foreground" Value="{DynamicResource DimBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Head"><Setter TargetName="T" Property="Foreground" Value="{DynamicResource Accent2Brush}"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Bullet" TargetType="Ellipse">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="Fill" Value="{DynamicResource Accent2Brush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,8,12,0"/>
        </Style>
        <Style x:Key="BulletText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Shell">
        <!-- ================= Фон: чёрный, который переливается ================= -->
        <Grid x:Name="BgLayer" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="Blob1" Width="1100" Height="800" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-330,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#707C3AED" Offset="0"/>
                        <GradientStop Color="#287C3AED" Offset="0.55"/>
                        <GradientStop Color="#007C3AED" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob1T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Blob2" Width="900" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#58C026D3" Offset="0"/>
                        <GradientStop Color="#1EC026D3" Offset="0.55"/>
                        <GradientStop Color="#00C026D3" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob2T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Blob3" Width="800" Height="640" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-260,0,0,-240">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#544F46E5" Offset="0"/>
                        <GradientStop Color="#1C4F46E5" Offset="0.55"/>
                        <GradientStop Color="#004F46E5" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob3T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Rectangle x:Name="Streak" Width="420" Height="2600" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00A78BFA" Offset="0"/>
                        <GradientStop Color="#1EA78BFA" Offset="0.5"/>
                        <GradientStop Color="#00A78BFA" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="24"/>
                        <TranslateTransform x:Name="StreakT" X="-900"/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="96"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= Шапка (фиолетовая) ================= -->
            <Grid x:Name="Header" Grid.Row="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                        <GradientStop Color="#5E2EBD" Offset="0"/>
                        <GradientStop Color="#3C1C8C" Offset="0.38"/>
                        <GradientStop Color="#160932" Offset="0.8"/>
                        <GradientStop Color="#090417" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Rectangle Opacity="0.7">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- тонкая акцентная линия снизу шапки, мягче прежней сплошной полосы -->
                <Rectangle Height="1.4" VerticalAlignment="Bottom">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00C084FC" Offset="0"/>
                            <GradientStop Color="#80C084FC" Offset="0.18"/>
                            <GradientStop Color="#C08B5CF6" Offset="0.5"/>
                            <GradientStop Color="#80C084FC" Offset="0.82"/>
                            <GradientStop Color="#00C084FC" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="96">
                    <!-- Значок-логотип: стилизованная молния в стеклянной плашке -->
                    <Border Width="46" Height="46" CornerRadius="13" BorderThickness="1.2" Margin="0,25,14,0">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#80E9D5FF" Offset="0"/>
                                <GradientStop Color="#308B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#55FFFFFF" Offset="0"/>
                                <GradientStop Color="#1A8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#C084FC" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <Path Data="M13,2 L4,14 H11 L9,22 L20,8 H13 Z" Stretch="Uniform" Width="20" Height="20">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#E9D5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Border>
                    <StackPanel VerticalAlignment="Top" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="XEOKA" FontSize="30" FontWeight="Black" Foreground="White"/>
                            <TextBlock x:Name="PackWord" Text="OPTIMIZATION" FontSize="30" FontWeight="Black" Margin="11,0,0,0">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E9D5FF" Offset="0"/>
                                        <GradientStop Color="#C084FC" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="SubTitle" Text="{local:T sub_title}" FontSize="12.5" Foreground="#CFC3F5" Margin="2,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- кнопки окна -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WinButton}" Click="MinBtn_Click" ToolTip="{local:T win_min}">
                        <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"><Path.LayoutTransform><ScaleTransform ScaleX="1.25" ScaleY="1.25"/></Path.LayoutTransform></Path>
                    </Button>
                    <Button Style="{StaticResource WinButton}" Click="MaxBtn_Click" ToolTip="{local:T win_max}">
                        <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"><Path.LayoutTransform><ScaleTransform ScaleX="1.25" ScaleY="1.25"/></Path.LayoutTransform></Path>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="CloseBtn_Click" ToolTip="{local:T win_close}">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"><Path.LayoutTransform><ScaleTransform ScaleX="1.25" ScaleY="1.25"/></Path.LayoutTransform></Path>
                    </Button>
                </StackPanel>

                <!-- Telegram: значок, при наведении раскрывается в капсулу -->
                <Grid x:Name="TgRoot" Width="52" Height="50" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,24,0"
                      Background="Transparent" Cursor="Hand" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      MouseEnter="TgRoot_MouseEnter" MouseLeave="TgRoot_MouseLeave" MouseLeftButtonUp="TgRoot_Click">
                    <Border x:Name="TgFill" CornerRadius="25" Opacity="0" BorderThickness="1.4" BorderBrush="#A78BFA">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2A1370" Offset="0"/>
                                <GradientStop Color="#48209E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel x:Name="TgTexts" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0" Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="TgLine1" Text="{local:T tg_author}" FontSize="10.5" Foreground="#B79CFF"/>
                        <TextBlock x:Name="TgLine2" Text="t.me/CMEPT0HOCHbIU" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                    <local:TgBadge x:Name="TgBadgeHdr" Width="50" Height="50" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <!-- ================= Низ: меню + страницы ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- боковое меню -->
                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource LineBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8C2A1260" Offset="0"/>
                            <GradientStop Color="#B005030B" Offset="0.45"/>
                            <GradientStop Color="#E005030B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Border x:Name="NavIndicator" Height="46" Margin="12,18,12,0" VerticalAlignment="Top" CornerRadius="13" BorderThickness="1" BorderBrush="#5AA78BFA">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#808B5CF6" Offset="0"/>
                                    <GradientStop Color="#40251546" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform><TranslateTransform x:Name="NavIndT" Y="0"/></Border.RenderTransform>
                            <Border Width="3.5" Height="24" HorizontalAlignment="Left" Margin="-1,0,0,0" CornerRadius="2" Background="{DynamicResource Accent2Brush}"/>
                        </Border>
                        <StackPanel Margin="12,18,12,0" VerticalAlignment="Top">
                            <RadioButton x:Name="NavOpt" Style="{StaticResource NavItem}" IsChecked="True" Tag="0" Click="Nav_Click" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M13,2 L4,14 L11,14 L9,22 L20,9 L13,9 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                    <TextBlock Text="{local:T nav_opt}" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Tag="1" Click="Nav_Click" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                    <TextBlock Text="{local:T nav_tools}" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="2" Click="Nav_Click" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="F0 M12,2 A10,10 0 1 1 11.99,2 Z M11,10.5 H13 V17 H11 Z M11,7 H13 V9 H11 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                    <TextBlock Text="{local:T nav_about}" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="3" Click="Nav_Click" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="F0 M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z M10.5,2 H13.5 L14,4.6 L16,5.5 L18.2,4 L20.3,6.1 L18.8,8.3 L19.6,10.3 L22,10.8 V13.2 L19.6,13.7 L18.8,15.7 L20.3,17.9 L18.2,20 L16,18.5 L14,19.4 L13.5,22 H10.5 L10,19.4 L8,18.5 L5.8,20 L3.7,17.9 L5.2,15.7 L4.4,13.7 L2,13.2 V10.8 L4.4,10.3 L5.2,8.3 L3.7,6.1 L5.8,4 L8,5.5 L10,4.6 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform"/>
                                    <TextBlock Text="{local:T nav_settings}" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,14">
                            <Border x:Name="SoundBtn" Cursor="Hand" Background="Transparent" Margin="6,0,0,10" MouseLeftButtonUp="SoundBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="SoundIcon" Data="M3,9 H7 L12,5 V19 L7,15 H3 Z M15,9 Q18,12 15,15 M17.5,6.5 Q23,12 17.5,17.5" Fill="#9D92BE" Stroke="#9D92BE" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform"/>
                                    <TextBlock x:Name="SoundText" Text="{local:T snd_on}" FontSize="12" Foreground="{DynamicResource DimBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{local:T hint_f11}" FontSize="11" Foreground="#6F6596" Margin="6,0,0,10"/>
                            <Border CornerRadius="14" Background="#CC120B22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.2" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="PackDot" Width="9" Height="9" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PackStatus" Text="{local:T pack_searching}" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PackPath" Text="" FontSize="10.5" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="46" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- страницы -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <!-- ===== Оптимизация ===== -->
                    <Grid x:Name="PageOpt" Margin="24,18,24,18" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><TranslateTransform x:Name="PageOptT"/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="{local:T opt_title}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                            <StackPanel x:Name="PackWarnPanelOpt" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                <TextBlock Text="{local:T pack_missing}" Foreground="{DynamicResource WarnBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Button Content="{local:T pick_pack}" Style="{StaticResource GhostButton}" Height="38" Padding="18,0" Click="PickBtn_Click"/>
                            </StackPanel>
                        </Grid>
                        <local:SmoothScrollViewer x:Name="OptScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OptScroll_SizeChanged">
                            <StackPanel Margin="0,0,10,0">
                                <Border Style="{StaticResource InfoCard}" Margin="0,0,0,14" Padding="20,14,12,6">
                                    <StackPanel>
                                        <TextBlock Text="{local:T sum_title}" Style="{StaticResource GroupLabel}" Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="SumList">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="{Binding Source={StaticResource Layout}, Path=SumWidth}" Margin="0,0,12,10">
                                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource DimBrush}"/>
                                                        <TextBlock Text="{Binding Value}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,2,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T grp_rec}" Style="{StaticResource GroupLabel}" VerticalAlignment="Center"/>
                                    <Rectangle Grid.Column="1" Height="1" Fill="{DynamicResource LineBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="RecList" ItemTemplate="{StaticResource TweakCard}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Grid Margin="0,6,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T grp_opt}" Style="{StaticResource GroupLabel}" VerticalAlignment="Center"/>
                                    <Rectangle Grid.Column="1" Height="1" Fill="{DynamicResource LineBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="OptList" ItemTemplate="{StaticResource TweakCard}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </local:SmoothScrollViewer>
                        <Grid Grid.Row="2" Margin="0,14,0,0" Height="62">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ApplyBtn" Content="{local:T btn_apply}" Style="{StaticResource PrimaryButton}" Margin="6,6,12,6" Click="ApplyBtn_Click"/>
                            <Button x:Name="RevertBtn" Grid.Column="1" Content="{local:T btn_revert}" Style="{StaticResource GhostButton}" Margin="0,4,12,4" Click="RevertBtn_Click"/>
                            <Button x:Name="AllBtn" Grid.Column="2" Content="{local:T btn_all}" Style="{StaticResource GhostButton}" Margin="0,4,0,4" Click="AllBtn_Click"/>
                        </Grid>
                        <Border x:Name="ProgTrack" Grid.Row="3" Height="8" CornerRadius="4" Margin="0,14,0,0" Background="{DynamicResource Panel2Brush}" Visibility="Collapsed">
                            <Border x:Name="ProgFill" CornerRadius="4" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5" Background="{DynamicResource AccentGradient}">
                                <Border.RenderTransform><ScaleTransform x:Name="ProgScale" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Border>
                        <Border Grid.Row="4" Height="150" Margin="0,14,0,0" CornerRadius="16" Background="#E6120B22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.2" Padding="16,10,6,10">
                            <local:SmoothScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LogList" ItemTemplate="{StaticResource LogLine}" Margin="0,0,10,0"/>
                            </local:SmoothScrollViewer>
                        </Border>

                        <!-- Анимация применения -->
                        <Grid x:Name="ApplyFx" Grid.RowSpan="5" Visibility="Collapsed" Opacity="0" Panel.ZIndex="20">
                            <Rectangle Fill="#D9030208" RadiusX="18" RadiusY="18"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="5" Margin="8"/>
                                    <Path x:Name="FxArc" Data="M60,8 A52,52 0 0 1 112,60" Stroke="{DynamicResource AccentGradient}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform x:Name="FxRot"/></Path.RenderTransform>
                                        <Path.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/></Path.Effect>
                                    </Path>
                                    <Path x:Name="FxCheck" Data="M36,62 L54,80 L86,42" Stroke="{DynamicResource OkBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><ScaleTransform x:Name="FxCheckScale" ScaleX="0.4" ScaleY="0.4"/></Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <TextBlock x:Name="FxTitle" Text="{local:T fx_working}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                <TextBlock x:Name="FxStep" FontSize="14" Foreground="{DynamicResource DimBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== Инструменты ===== -->
                    <Grid x:Name="PageTools" Margin="24,18,24,18" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform x:Name="PageToolsT"/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{local:T tools_title}" Style="{StaticResource H1}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{local:T tools_sub}" FontSize="13" Foreground="{DynamicResource DimBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource AmberGradient}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ToolsRiskText" FontSize="12.5" Foreground="{DynamicResource DimBrush}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="PackWarnPanelTools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                <TextBlock Text="{local:T pack_missing}" Foreground="{DynamicResource WarnBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Button Content="{local:T pick_pack}" Style="{StaticResource GhostButton}" Height="38" Padding="18,0" Click="PickBtn_Click"/>
                            </StackPanel>
                        </Grid>
                        <local:SmoothScrollViewer x:Name="ToolsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="ToolsScroll_SizeChanged">
                            <ItemsControl x:Name="ToolsList" ItemTemplate="{StaticResource ToolCard}" Margin="0,0,10,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </local:SmoothScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{local:T open_pack}" Style="{StaticResource GhostButton}" Width="240" Height="46" Click="OpenPackBtn_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== О программе ===== -->
                    <Grid x:Name="PageAbout" Margin="24,18,24,18" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform x:Name="PageAboutT"/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{local:T nav_about}" Style="{StaticResource H1}" Margin="0,0,0,14"/>
                        <local:SmoothScrollViewer x:Name="AboutScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="AboutScroll_SizeChanged">
                            <StackPanel Margin="0,0,10,0">
                                <!-- hero -->
                                <Border CornerRadius="24" BorderThickness="1.2" BorderBrush="#66A78BFA" Margin="0,0,0,14" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5A2BB8" Offset="0"/>
                                            <GradientStop Color="#2A1260" Offset="0.5"/>
                                            <GradientStop Color="#0F0824" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid MinHeight="170">
                                        <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-60,0" Fill="#20FFFFFF"/>
                                        <Ellipse Width="240" Height="240" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,150,-120" Fill="#18C084FC"/>
                                        <StackPanel Margin="34,26,34,26" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="XEOKA" FontSize="46" FontWeight="Black" Foreground="White"/>
                                                <TextBlock Text="OPTIMIZATION" FontSize="46" FontWeight="Black" Foreground="#E3C9FF" Margin="14,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AboutVersion" Text="{local:T sub_title}" FontSize="14" Foreground="#CFC3F5" Margin="3,0,0,14"/>
                                            <WrapPanel>
                                                <Border CornerRadius="15" Background="#30000000" BorderBrush="#66A78BFA" BorderThickness="1" Padding="12,6" Margin="0,0,10,8">
                                                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center"/><TextBlock Text="{local:T chip_rp}" Style="{StaticResource ChipText}"/></StackPanel>
                                                </Border>
                                                <Border CornerRadius="15" Background="#30000000" BorderBrush="#66A78BFA" BorderThickness="1" Padding="12,6" Margin="0,0,10,8">
                                                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center"/><TextBlock Text="{local:T chip_revert}" Style="{StaticResource ChipText}"/></StackPanel>
                                                </Border>
                                                <Border CornerRadius="15" Background="#30000000" BorderBrush="#66A78BFA" BorderThickness="1" Padding="12,6" Margin="0,0,10,8">
                                                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center"/><TextBlock Text="{local:T chip_auto}" Style="{StaticResource ChipText}"/></StackPanel>
                                                </Border>
                                                <Border CornerRadius="15" Background="#30000000" BorderBrush="#66A78BFA" BorderThickness="1" Padding="12,6" Margin="0,0,10,8">
                                                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center"/><TextBlock Text="{local:T chip_admin}" Style="{StaticResource ChipText}"/></StackPanel>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- три карточки -->
                                <WrapPanel>
                                    <Border Style="{StaticResource InfoCard}" Width="{Binding Source={StaticResource Layout}, Path=AboutCardWidth}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Grid Width="40" Height="40">
                                                    <Ellipse Fill="{DynamicResource AccentGradient}"/>
                                                    <Path Data="M12,20 L18,26 L28,14" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Grid>
                                                <TextBlock Text="{local:T c1_title}" FontSize="17" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Style="{StaticResource Bullet}"/><TextBlock Grid.Column="1" Style="{StaticResource BulletText}" Text="{local:T c1_b1}"/></Grid>
                                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Style="{StaticResource Bullet}"/><TextBlock Grid.Column="1" Style="{StaticResource BulletText}" Text="{local:T c1_b2}"/></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Style="{StaticResource Bullet}"/><TextBlock Grid.Column="1" Style="{StaticResource BulletText}" Text="{local:T c1_b3}"/></Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InfoCard}" Width="{Binding Source={StaticResource Layout}, Path=AboutCardWidth}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Grid Width="40" Height="40">
                                                    <Ellipse Fill="{DynamicResource AccentGradient}"/>
                                                    <Path Data="M12,12 H19 V19 H12 Z M21,12 H28 V19 H21 Z M12,21 H19 V28 H12 Z M21,21 H28 V28 H21 Z" Fill="White"/>
                                                </Grid>
                                                <TextBlock Text="{local:T c2_title}" FontSize="17" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Style="{StaticResource Bullet}"/><TextBlock Grid.Column="1" Style="{StaticResource BulletText}" Text="{local:T c2_b1}"/></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Style="{StaticResource Bullet}"/><TextBlock Grid.Column="1" Style="{StaticResource BulletText}" Text="{local:T c2_b2}"/></Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InfoCard}" Width="{Binding Source={StaticResource Layout}, Path=AboutCardWidth}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Grid Width="40" Height="40">
                                                    <Ellipse Fill="{DynamicResource AmberGradient}"/>
                                                    <Path Data="M20,12 V22" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Ellipse Width="3.6" Height="3.6" Fill="White" Margin="0,16,0,0"/>
                                                </Grid>
                                                <TextBlock Text="{local:T c3_title}" FontSize="17" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Style="{StaticResource Bullet}"/><TextBlock Grid.Column="1" Style="{StaticResource BulletText}" Text="{local:T c3_b1}"/></Grid>
                                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Style="{StaticResource Bullet}"/><TextBlock Grid.Column="1" Style="{StaticResource BulletText}" Text="{local:T c3_b2}"/></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Style="{StaticResource Bullet}"/><TextBlock Grid.Column="1" Style="{StaticResource BulletText}" Text="{local:T c3_b3}"/></Grid>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <!-- Telegram -->
                                <Border CornerRadius="22" BorderThickness="1.2" BorderBrush="#7746C3FF" Padding="26,22" Margin="0,0,14,14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#16336B" Offset="0"/>
                                            <GradientStop Color="#2A1260" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <local:TgBadge x:Name="TgBadgeAbout" Width="84" Height="84">
                                            <local:TgBadge.RingBrush><SolidColorBrush Color="#46C3FF"/></local:TgBadge.RingBrush>
                                        </local:TgBadge>
                                        <StackPanel Grid.Column="1" Margin="22,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{local:T tg_banner_t}" FontSize="11" FontWeight="SemiBold" Foreground="#46C3FF"/>
                                            <TextBlock Text="t.me/CMEPT0HOCHbIU" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                            <TextBlock Text="{local:T tg_banner_s}" FontSize="13" Foreground="#B7B2D9" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{local:T open_tg}" Style="{StaticResource PrimaryButton}" Width="230" Height="58" VerticalAlignment="Center" Margin="8" Click="OpenTgBtn_Click"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource InfoCard}" Margin="0,0,14,14" Padding="22,16">
                                    <StackPanel>
                                        <TextBlock Text="{local:T legal_title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                                        <TextBlock Text="{local:T legal}" FontSize="13" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,0,14,6">
                                    <TextBlock x:Name="LogPathText" FontSize="11.5" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,420,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{local:T open_logs}" Style="{StaticResource GhostButton}" Width="180" Height="42" Margin="0,0,12,0" Click="OpenLogsBtn_Click"/>
                                        <Button Content="{local:T open_pack}" Style="{StaticResource GhostButton}" Width="200" Height="42" Click="OpenPackBtn_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </local:SmoothScrollViewer>
                    </Grid>

                    <!-- ===== Настройки ===== -->
                    <Grid x:Name="PageSettings" Margin="24,18,24,18" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform x:Name="PageSettingsT"/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{local:T set_title}" Style="{StaticResource H1}" Margin="0,0,0,14"/>
                        <local:SmoothScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,10,0" MaxWidth="900" HorizontalAlignment="Left">
                                <Border Style="{StaticResource InfoCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{local:T set_lang}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{local:T set_lang_sub}" FontSize="12.5" Foreground="{DynamicResource DimBrush}" Margin="0,3,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="LangRu" Content="Русский" Tag="ru" Style="{StaticResource GhostButton}" Width="140" Height="42" Margin="0,0,10,0" Click="Lang_Click"/>
                                            <Button x:Name="LangEn" Content="English" Tag="en" Style="{StaticResource GhostButton}" Width="140" Height="42" Margin="0,0,10,0" Click="Lang_Click"/>
                                            <Button x:Name="LangAuto" Content="{local:T lang_auto}" Tag="auto" Style="{StaticResource GhostButton}" Width="120" Height="42" Click="Lang_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{local:T set_theme}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{local:T set_theme_sub}" FontSize="12.5" Foreground="{DynamicResource DimBrush}" Margin="0,3,0,12"/>
                                        <ItemsControl x:Name="ThemeList">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Tag="{Binding Id}" Width="118" Margin="0,0,12,12" Padding="10" CornerRadius="14" BorderThickness="1.4" Cursor="Hand"
                                                            Background="#33000000" BorderBrush="{Binding Border}" MouseLeftButtonUp="Theme_Click">
                                                        <StackPanel>
                                                            <Ellipse Width="44" Height="44" Fill="{Binding SwatchBrush}" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoCard}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{local:T set_sound}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{local:T set_sound_sub}" FontSize="12.5" Foreground="{DynamicResource DimBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="SetSoundBtn" Grid.Column="1" Style="{StaticResource GhostButton}" Width="120" Height="42" VerticalAlignment="Center" Click="SetSoundBtn_Click"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource InfoCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{local:T set_support}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{local:T set_support_sub}" FontSize="12.5" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" Margin="0,3,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SupportBtn" Content="{local:T btn_support}" Style="{StaticResource PrimaryButton}" Width="210" Height="48" Margin="0,0,12,0" Click="SupportBtn_Click"/>
                                            <Button Content="{local:T btn_data}" Style="{StaticResource GhostButton}" Width="170" Height="44" VerticalAlignment="Center" Click="OpenLogsBtn_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </local:SmoothScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= Диалог ================= -->
        <Grid x:Name="Overlay" Visibility="Collapsed" Panel.ZIndex="100">
            <Rectangle x:Name="OverlayDim" Fill="#C0030208" Opacity="0"/>
            <Border x:Name="DlgCard" Width="540" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="22" BorderThickness="1.2" BorderBrush="#66A78BFA" Padding="28,24,28,22" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1F1240" Offset="0"/>
                        <GradientStop Color="#0E0820" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DlgScale" ScaleX="0.94" ScaleY="0.94"/>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock x:Name="DlgTitle" FontSize="20" FontWeight="SemiBold" Text="xeoka optimization"/>
                    <TextBlock x:Name="DlgText" FontSize="14" Foreground="#C9C0E8" TextWrapping="Wrap" Margin="0,12,0,22" LineHeight="21"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DlgNo" Content="{local:T dlg_cancel}" Style="{StaticResource GhostButton}" Width="130" Height="44" Margin="0,0,12,0" Click="DlgNo_Click"/>
                        <Button x:Name="DlgYes" Content="{local:T dlg_continue}" Style="{StaticResource PrimaryButton}" Width="170" Height="44" Margin="6" Click="DlgYes_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Активация ================= -->
        <Grid x:Name="ActivationOverlay" Visibility="Collapsed" Panel.ZIndex="200" ClipToBounds="True">
            <Rectangle Fill="#030208" Margin="0,96,0,0"/>
            <MediaElement x:Name="ActVideo" Margin="0,96,0,0" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          IsHitTestVisible="False" MediaEnded="ActVideo_MediaEnded" Volume="0.1"/>
            <Rectangle Fill="#1A000000" Margin="0,96,0,0"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="560" MaxWidth="620" CornerRadius="22" BorderThickness="1.2" BorderBrush="{DynamicResource Accent2Brush}" Padding="32,28">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.55"/>
                    </Border.Effect>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#731A1038" Offset="0"/>
                            <GradientStop Color="#730B0718" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="XEOKA" FontSize="26" FontWeight="Black" Foreground="White">
                                <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="OPTIMIZATION" FontSize="26" FontWeight="Black" Foreground="{DynamicResource Accent2Brush}" Margin="10,0,0,0">
                                <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{local:T act_title}" FontSize="14" Foreground="{DynamicResource DimBrush}" Margin="0,4,0,20" TextWrapping="Wrap">
                            <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                        </TextBlock>

                        <TextBlock Text="{local:T act_hwid_label}" FontSize="12.5" Foreground="{DynamicResource DimBrush}">
                            <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                        </TextBlock>
                        <Grid Margin="0,6,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Background="#75000000" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <TextBlock x:Name="ActHwidText" FontSize="16" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                            <Button Grid.Column="1" Content="{local:T act_copy}" Style="{StaticResource GhostButton}" Width="110" Height="42" Margin="10,0,0,0" Click="ActCopyHwid_Click"/>
                        </Grid>

                        <TextBlock Text="{local:T act_code_label}" FontSize="12.5" Foreground="{DynamicResource DimBrush}">
                            <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                        </TextBlock>
                        <TextBox x:Name="ActCodeBox" Margin="0,6,0,10" Padding="12,10" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                 Background="#75000000" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="ActError" FontSize="12.5" Foreground="{DynamicResource ErrBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="{local:T act_buy}" Style="{StaticResource GhostButton}" Width="150" Height="46" Margin="0,0,12,0" Click="ActBuy_Click"/>
                            <Button x:Name="ActActivateBtn" Content="{local:T act_activate}" Style="{StaticResource PrimaryButton}" Width="170" Height="46" Click="ActActivate_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Громкость видео: прямо под меню ввода ключа -->
                <Border x:Name="ActVolumePanel" HorizontalAlignment="Center" Margin="0,16,0,0" CornerRadius="14" Background="#75000000" Padding="16,10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="F1 M3,9 H7 L12,5 V19 L7,15 H3 Z M15,9 C17,10.5 17,13.5 15,15 M18,6 C22,9.5 22,14.5 18,18" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"/>
                        <Slider x:Name="ActVolumeSlider" Width="140" Minimum="0" Maximum="1" Value="0.1" Margin="12,0,0,0" VerticalAlignment="Center" ValueChanged="ActVolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
